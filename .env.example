# =============================================================
# SentinelOps environment configuration
# Copy this file to .env and replace every "change-me" value:
#     copy .env.example .env        (Windows CMD)
#     cp .env.example .env          (Linux / macOS)
# NEVER commit your real .env file.
# =============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=sentinelops
MYSQL_USER=sentinel
MYSQL_PASSWORD=change-me-db-password
# Host port mapped to MySQL (3307 avoids clashing with a local MySQL on 3306)
MYSQL_HOST_PORT=3307

# ---------- SentinelOps Dashboard ----------
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-flask-secret-key
# API key Jenkins (or curl) must send in the X-API-Key header for POST /api/deployments
SENTINELOPS_API_KEY=change-me-api-key
DASHBOARD_PORT=5000
FLASK_ENV=production
LOG_LEVEL=INFO
# Optional bootstrap admin account created on first start (leave blank to skip)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Load sample services / deployments / incidents on first start (true/false)
SEED_DEMO_DATA=true
# Gunicorn workers for the dashboard
GUNICORN_WORKERS=2

# ---------- Demo Application ----------
DEMO_APP_PORT=8080
APP_VERSION=1.0.0
BUILD_NUMBER=local
COMMIT_ID=local
# Set BREAK=true to simulate a broken release (health checks return HTTP 500)
BREAK=false
